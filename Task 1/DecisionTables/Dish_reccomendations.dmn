  {"name": "Lasagna alla Bolognese", "calories": 750, "allergens": ["gluten", "milk", "eggs", "celery"]},
  {"name": "Penne all'Arrabbiata", "calories": 325, "allergens": ["gluten"]},
  {"name": "Bistecca alla Fiorentina", "calories": 655, "allergens": []},
  {"name": "Pollo alla Cacciatora", "calories": 570, "allergens": ["celery"]},
  {"name": "Melanzane alla Parmigiana", "calories": 550, "allergens": ["gluten", "milk", "eggs"]},
  {"name": "Margherita", "calories": 600, "allergens": ["gluten", "milk"]},
  {"name": "Diavola", "calories": 650, "allergens": ["gluten", "milk"]},
  {"name": "Prosciutto e Funghi", "calories": 700, "allergens": ["gluten", "milk"]},
  {"name": "Fornarina", "calories": 250, "allergens": ["gluten", "milk"]},
  {"name": "Gluten-free Margherita", "calories": 850, "allergens": ["milk"]},
  {"name": "Tiramisù", "calories": 450, "allergens": ["gluten", "eggs", "milk"]},
  {"name": "Panna Cotta", "calories": 250, "allergens": ["milk"]},
  {"name": "Biscotti", "calories": 125, "allergens": ["gluten", "milk", "eggs", "nuts"]}  
]</text>
    </literalExpression>

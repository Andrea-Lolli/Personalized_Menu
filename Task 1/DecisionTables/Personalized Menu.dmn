        </semantic:informationRequirement>
        <semantic:informationRequirement id="_9aeee91e-489d-46af-b447-60adfa520349" triso:readOnly="false">
            <semantic:requiredInput href="#_b181f1a2-6603-4d9d-9922-f3b991173a7b"/>
        </semantic:informationRequirement>
        <semantic:informationRequirement id="_87d5d8c3-6a32-4c72-9f1a-36af5ea928ad" triso:readOnly="false">
            <semantic:requiredDecision href="#_ffe7ac2a-682c-4e47-b4a2-93ac81d68b75"/>
        </semantic:informationRequirement>
        <semantic:literalExpression typeRef="Any" id="_a73c5d36-deba-4f91-9361-88ed36e7f6b9" triso:expressionId="_b6f1435b-2606-45c2-ada2-03eeb34befc3" triso:descriptionVisible="false">
            <semantic:text>for item in Meals return
  if list contains(MatchesDiet, item.name) and list contains(MatchesAllergies, item.name) and list contains(MatchesCalories, item.name)
  then item
  else ""</semantic:text>
        </semantic:literalExpression>
    </semantic:decision>

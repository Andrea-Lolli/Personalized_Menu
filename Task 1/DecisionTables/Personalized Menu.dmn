    <semantic:decision id="_01f0a2a0-7ad7-40c1-ae93-fba3cd3f42e0" name="MatchesDiet" triso:readOnly="false" triso:useOutputTypeAsAnswer="false">
        <semantic:variable name="MatchesDiet" id="_e3cb525b-69a1-411b-a191-39e4ec347c99" typeRef="string"/>
        <semantic:informationRequirement id="_5fc05067-fd71-493d-b727-b9b873644e36" triso:readOnly="false">
            <semantic:requiredInput href="#_c106993f-f1a6-451b-95b6-32c036649a03"/>
        </semantic:informationRequirement>
        <semantic:informationRequirement id="_b96fc31e-b7de-4da1-8173-852befafa078" triso:readOnly="false">
            <semantic:requiredInput href="#_b181f1a2-6603-4d9d-9922-f3b991173a7b"/>
        </semantic:informationRequirement>
        <semantic:literalExpression typeRef="string" id="_f8382cc0-5aa7-4a54-97ee-24fa000649a0" triso:expressionId="_cdd7339d-44ca-468e-8737-56d5a94a0343" triso:descriptionVisible="false">
            <semantic:text>for item in Meals return
  if  Guest Profile.DietPreference = "Vegan" then
    if not(list contains(item.ingredients, "meat")) and not(list contains(item.ingredients, "milk")) and not(list contains(item.ingredients, "eggs")) then item.name
    else null
  else if Guest Profile.DietPreference = "Vegetarian" then
    if not(list contains(item.ingredients, "meat")) then item.name
    else null
  else if Guest Profile.DietPreference = "Omnivore" then
    item.name
  else
    null</semantic:text>
        </semantic:literalExpression>
    </semantic:decision>
    <semantic:decision id="_ca2fc131-d3a4-4c8e-98f0-8d8e580cf7ce" name="MatchesAllergies" triso:readOnly="false" triso:useOutputTypeAsAnswer="false">
        <semantic:variable name="MatchesAllergies" id="_fafe0deb-5ab2-44e1-8808-58f6dc644c5c" typeRef="Any"/>
        <semantic:informationRequirement id="_499773e5-c87e-4558-80bc-53667c03f475" triso:readOnly="false">
            <semantic:requiredInput href="#_c106993f-f1a6-451b-95b6-32c036649a03"/>
        </semantic:informationRequirement>
        <semantic:informationRequirement id="_409a34eb-dbb9-4f37-b4b6-899da03ef9e6" triso:readOnly="false">
            <semantic:requiredInput href="#_b181f1a2-6603-4d9d-9922-f3b991173a7b"/>
        </semantic:informationRequirement>
        <semantic:literalExpression typeRef="Any" id="_16a0f50b-8f2b-437c-85c0-0245f54e970d" triso:expressionId="_e86fbb34-4830-4aab-8607-4a1a780c7537" triso:descriptionVisible="false">
            <semantic:text>for item in Meals return
  if every a in Guest Profile.Allergies satisfies not(list contains(item.allergens, a)) then
    item.name
  else
    null</semantic:text>
        </semantic:literalExpression>
    </semantic:decision>

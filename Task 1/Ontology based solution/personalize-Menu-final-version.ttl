#################################################################

:g rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:m rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

ex:g rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

ex:m rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "VeganOnlyRule" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :VeganMeal ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> ex:m
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasAllergy ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> ex:g ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :None
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasDiet ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> ex:g ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :Vegan
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :isCalorieConscious ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> ex:g ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> "false"^^xsd:boolean
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#classPredicate> :Guest ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> ex:g
                                                                                                 ] ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasSuitableMeal ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> ex:g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> ex:m
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .


@prefix : <http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#> .
@prefix ex: <http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#> .

<http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#hasAllergy
:hasAllergy rdf:type owl:ObjectProperty ;
            rdfs:domain :Guest ;
            rdfs:range :Dairy ,
                       :Eggs ,
                       :Gluten ,
                       :Meat ,
                       :None ,
                       :Vegetable .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#hasDiet
:hasDiet rdf:type owl:ObjectProperty ;
         rdfs:domain :Guest ;
         rdfs:range :Diet .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty ;
               rdfs:domain :Meal ;
               rdfs:range :Ingredient .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#hasSuitableMeal
:hasSuitableMeal rdf:type owl:ObjectProperty ;
                 rdfs:domain :Guest ;
                 rdfs:range :Meal .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#hasCalories
:hasCalories rdf:type owl:DatatypeProperty ;
             rdfs:domain :Meal ;
             rdfs:range xsd:integer .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#hasCourse
:hasCourse rdf:type owl:DatatypeProperty ;
           rdfs:domain :Meal ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#isCalorieConscious
:isCalorieConscious rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Guest ;
                    rdfs:range xsd:boolean .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#isVegan
:isVegan rdf:type owl:DatatypeProperty ;
         rdfs:domain :Meal ;
         rdfs:range xsd:boolean .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#notContainsGluten
:notContainsGluten rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Meal ;
                   rdfs:range xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#CalorieConsciousMeal
:CalorieConsciousMeal rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Meal
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasCalories ;
                                                                   owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                        owl:onDatatype xsd:integer ;
                                                                                        owl:withRestrictions ( [ xsd:maxExclusive 500
                                                                                                               ]
                                                                                                             )
                                                                                      ]
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf :Meal .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Dairy
:Dairy rdf:type owl:Class ;
       rdfs:subClassOf :Ingredient .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Diet
:Diet rdf:type owl:Class .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Eggs
:Eggs rdf:type owl:Class ;
      rdfs:subClassOf :Ingredient .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#GFCalMeal
:GFCalMeal rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :GlutenFreeMeal
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :hasCalories ;
                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                             owl:onDatatype xsd:integer ;
                                                                             owl:withRestrictions ( [ xsd:maxExclusive 500
                                                                                                    ]
                                                                                                  )
                                                                           ]
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :GlutenFreeMeal .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#GFCalVeg
:GFCalVeg rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :GlutenFreeMeal
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasCalories ;
                                                       owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                            owl:onDatatype xsd:integer ;
                                                                            owl:withRestrictions ( [ xsd:maxExclusive 500
                                                                                                   ]
                                                                                                 )
                                                                          ]
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :isVegan ;
                                                       owl:hasValue "true"^^xsd:boolean
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :GlutenFreeMeal .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#GFVegMeal
:GFVegMeal rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :GlutenFreeMeal
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isVegan ;
                                                        owl:hasValue "true"^^xsd:boolean
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :GlutenFreeMeal .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Gluten
:Gluten rdf:type owl:Class ;
        rdfs:subClassOf :Ingredient .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#GlutenFree
:GlutenFree rdf:type owl:Class ;
            rdfs:subClassOf :Ingredient .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#GlutenFreeMeal
:GlutenFreeMeal rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Meal
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :notContainsGluten ;
                                                             owl:hasValue "true"^^xsd:boolean
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Meal .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Guest
:Guest rdf:type owl:Class .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Ingredient
:Ingredient rdf:type owl:Class .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Meal
:Meal rdf:type owl:Class .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Meat
:Meat rdf:type owl:Class ;
      rdfs:subClassOf :Ingredient .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#None
:None rdf:type owl:Class ;
      rdfs:subClassOf :Ingredient .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#VegCalMeal
:VegCalMeal rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :VeganMeal
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasCalories ;
                                                         owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                              owl:onDatatype xsd:integer ;
                                                                              owl:withRestrictions ( [ xsd:maxExclusive 500
                                                                                                     ]
                                                                                                   )
                                                                            ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :VeganMeal .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#VeganMeal
:VeganMeal rdf:type owl:Class ;
           owl:equivalentClass [ owl:intersectionOf ( :Meal
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isVegan ;
                                                        owl:hasValue "true"^^xsd:boolean
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
           rdfs:subClassOf :Meal .


###  http://www.semanticweb.org/angel/ontologies/2025/5/personalized-menu#Vegetable
:Vegetable rdf:type owl:Class ;
           rdfs:subClassOf :Ingredient .


